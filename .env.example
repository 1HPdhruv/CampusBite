# Copy to .env.local. Set secrets locally or in Vercel; never commit values.
# Required: Gemini API key, kept server-only.
GEMINI_API_KEY=
# Configurable text model; documented by Google on 2026-11-11.
GEMINI_MODEL=gemini-3.8-flash
# Existing infrastructure names retained. Required only for supabase storage.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Required: strong team access passcode and server-side signing secret.
APP_PASSCODE=
# Required for public synthetic passenger selection. Otherwise access fails closed.
DEMO_MODE=true
# memory: bundled fixtures, tickets reset on server restart; no remote DB writes.
# supabase: reviewed migration + seed must already be applied; durable tickets.
METRO_STORAGE=memory
# Optional Live: default browser recognition/synthesis remains available.
# Enable only after account/device testing. Permanent key stays server-only.
GEMINI_LIVE_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
